<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram name="Adaptive Retrieval Pipeline" id="ai-service-pipeline">
    <mxGraphModel dx="1900" dy="1500" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1900" pageHeight="1500">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="UniChat AI Service — Adaptive Retrieval &amp; Reasoning Pipeline" style="text;html=1;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="300" y="10" width="600" height="40" as="geometry" />
        </mxCell>

        <!-- ===== PHASE 1: Input Validation ===== -->
        <mxCell id="phase1" value="1. Xác thực đầu vào" style="swimlane;startSize=25;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="340" height="280" as="geometry" />
        </mxCell>

        <mxCell id="start" value="POST /internal/v1/&#xa;retrieval/answers" style="shape=mxgraph.flowchart.terminator;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;" vertex="1" parent="phase1">
          <mxGeometry x="70" y="35" width="200" height="45" as="geometry" />
        </mxCell>

        <mxCell id="p1_jwt" value="Xác thực Service JWT&#xa;• RS256 signature&#xa;• Kiểm tra replay (jti)&#xa;• Claim binding&#xa;(method/path/bodyHash)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="phase1">
          <mxGeometry x="40" y="95" width="260" height="80" as="geometry" />
        </mxCell>

        <mxCell id="p1_validate" value="Validate request schema&#xa;• workspaceId (UUID)&#xa;• allowedDocumentIds (≥1)&#xa;• question (3–2000 chars)&#xa;• strategyVersion, requestId" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="phase1">
          <mxGeometry x="40" y="190" width="260" height="80" as="geometry" />
        </mxCell>

        <mxCell id="ep1_1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;" edge="1" parent="phase1" source="start" target="p1_jwt">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ep1_2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;" edge="1" parent="phase1" source="p1_jwt" target="p1_validate">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ===== PHASE 2: Question Normalization ===== -->
        <mxCell id="phase2" value="2. Chuẩn hóa câu hỏi" style="swimlane;startSize=25;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="420" y="60" width="340" height="280" as="geometry" />
        </mxCell>

        <mxCell id="p2_nfc" value="Unicode NFC +&#xa;Chuẩn hóa khoảng trắng" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="phase2">
          <mxGeometry x="40" y="35" width="260" height="50" as="geometry" />
        </mxCell>

        <mxCell id="p2_lower" value="Tạo bản chữ thường&#xa;(giữ nguyên dấu tiếng Việt)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="phase2">
          <mxGeometry x="40" y="100" width="260" height="50" as="geometry" />
        </mxCell>

        <mxCell id="p2_shadow" value="Tạo shadow text&#xa;(bỏ dấu — chỉ dùng&#xa;so luật, KHÔNG sinh câu trả lời)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="phase2">
          <mxGeometry x="40" y="165" width="260" height="55" as="geometry" />
        </mxCell>

        <mxCell id="p2_hash" value="Tạo hash câu hỏi cho trace&#xa;(không log toàn văn vào log vận hành)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="phase2">
          <mxGeometry x="40" y="235" width="260" height="40" as="geometry" />
        </mxCell>

        <mxCell id="ep2_1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;" edge="1" parent="phase2" source="p2_nfc" target="p2_lower">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ep2_2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;" edge="1" parent="phase2" source="p2_lower" target="p2_shadow">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ep2_3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;" edge="1" parent="phase2" source="p2_shadow" target="p2_hash">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ===== PHASE 3: Intent Detection ===== -->
        <mxCell id="phase3" value="3. Phát hiện Intent (Luật xác định)" style="swimlane;startSize=25;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="800" y="60" width="380" height="280" as="geometry" />
        </mxCell>

        <mxCell id="p3_rules" value="YAML Rules Engine&#xa;(strategyVersion + ruleId + patterns)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;" vertex="1" parent="phase3">
          <mxGeometry x="50" y="35" width="280" height="50" as="geometry" />
        </mxCell>

        <mxCell id="p3_priority" value="Thứ tự ưu tiên:&#xa;OUT_OF_SCOPE → COMPARISON&#xa;→ SUMMARY → DEFINITION&#xa;→ REASONING → FACT (fallback)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="phase3">
          <mxGeometry x="50" y="100" width="280" height="70" as="geometry" />
        </mxCell>

        <mxCell id="p3_check" value="Câu hỏi mơ hồ?&#xa;(quá ngắn, đại từ&#xa;không xác định, thiếu&#xa;đối tượng so sánh)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="phase3">
          <mxGeometry x="80" y="185" width="220" height="80" as="geometry" />
        </mxCell>

        <mxCell id="ep3_1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;" edge="1" parent="phase3" source="p3_rules" target="p3_priority">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ep3_2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;" edge="1" parent="phase3" source="p3_priority" target="p3_check">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ===== PHASE 4: Strategy Selection ===== -->
        <mxCell id="phase4" value="4. Strategy Selection" style="swimlane;startSize=25;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="1220" y="60" width="350" height="280" as="geometry" />
        </mxCell>

        <mxCell id="p4_map" value="strategy_selector.py&#xa;&#xa;Intent → Retrieval Parameters" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="phase4">
          <mxGeometry x="40" y="35" width="270" height="55" as="geometry" />
        </mxCell>

        <mxCell id="p4_table" value="FACT: topK=5, floor=0.70, max=4, minGrp=1, gate=0.72&#xa;DEFINITION: topK=4, floor=0.72, max=3, minGrp=1, gate=0.74&#xa;COMPARISON: topK=10, floor=0.64, max=6, minGrp=2, gate=0.68&#xa;SUMMARY: topK=12, floor=0.60, max=8, minGrp=3, gate=0.66&#xa;REASONING: topK=12, floor=0.62, max=8, minGrp=2, gate=0.68" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;size=14;align=left;fontSize=10;" vertex="1" parent="phase4">
          <mxGeometry x="15" y="105" width="320" height="100" as="geometry" />
        </mxCell>

        <mxCell id="p4_config" value="Khóa config:&#xa;providerModel, promptVersion,&#xa;embeddingRevision, strategyVersion,&#xa;temperature, configHash" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="phase4">
          <mxGeometry x="40" y="215" width="270" height="55" as="geometry" />
        </mxCell>

        <mxCell id="ep4_1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;" edge="1" parent="phase4" source="p4_map" target="p4_table">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ep4_2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;" edge="1" parent="phase4" source="p4_table" target="p4_config">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ===== PHASE 5: Vector Retrieval ===== -->
        <mxCell id="phase5" value="5. Vector Retrieval (ChromaDB)" style="swimlane;startSize=25;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="380" width="460" height="260" as="geometry" />
        </mxCell>

        <mxCell id="p5_embed" value="Embedding câu hỏi&#xa;multilingual-e5-base (768d)&#xa;prefix: query:" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="phase5">
          <mxGeometry x="30" y="40" width="190" height="65" as="geometry" />
        </mxCell>

        <mxCell id="p5_query" value="ChromaDB Cosine Query&#xa;unichat_chunks_v1" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="phase5">
          <mxGeometry x="250" y="35" width="190" height="75" as="geometry" />
        </mxCell>

        <mxCell id="p5_filter" value="Bộ lọc bắt buộc:&#xa;• workspaceId = request.workspaceId&#xa;• documentId ∈ allowedDocumentIds&#xa;• documentStatus = PROCESSED&#xa;• ingestionVersion = hiện hành" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;size=14;align=left;fontSize=10;" vertex="1" parent="phase5">
          <mxGeometry x="30" y="125" width="260" height="90" as="geometry" />
        </mxCell>

        <mxCell id="p5_result" value="Kết quả:&#xa;chunks + scores&#xa;+ metadata locators" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="phase5">
          <mxGeometry x="310" y="140" width="140" height="60" as="geometry" />
        </mxCell>

        <mxCell id="ep5_1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;" edge="1" parent="phase5" source="p5_embed" target="p5_query">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ep5_2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;" edge="1" parent="phase5" source="p5_query" target="p5_result">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ===== PHASE 6: Evidence Gate ===== -->
        <mxCell id="phase6" value="6. Evidence Gate (Quyết định)" style="swimlane;startSize=25;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="540" y="380" width="480" height="260" as="geometry" />
        </mxCell>

        <mxCell id="p6_score" value="Tính Evidence Score&#xa;&#xa;evidenceScore = 0.50 × topSimilarity&#xa;+ 0.30 × meanTop3Similarity&#xa;+ 0.20 × coverageScore&#xa;&#xa;coverageScore ∈ [0,1] = số nhóm&#xa;nguồn cần thiết theo intent" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=0;align=left;" vertex="1" parent="phase6">
          <mxGeometry x="20" y="35" width="260" height="120" as="geometry" />
        </mxCell>

        <mxCell id="p6_decision" value="score ≥ gate&#xa;AND đủ&#xa;source groups?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="phase6">
          <mxGeometry x="310" y="40" width="150" height="110" as="geometry" />
        </mxCell>

        <mxCell id="p6_answer" value="✅ ANSWER&#xa;(Tiếp tục sinh câu trả lời)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="phase6">
          <mxGeometry x="300" y="170" width="170" height="50" as="geometry" />
        </mxCell>

        <mxCell id="p6_refuse" value="❌ REFUSE&#xa;(Thiếu bằng chứng,&#xa;gợi ý thu hẹp câu hỏi)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="phase6">
          <mxGeometry x="20" y="175" width="200" height="50" as="geometry" />
        </mxCell>

        <mxCell id="ep6_1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;" edge="1" parent="phase6" source="p6_score" target="p6_decision">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ep6_yes" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#82b366;" edge="1" parent="phase6" source="p6_decision" target="p6_answer">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ep6_no" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#b85450;" edge="1" parent="phase6" source="p6_decision" target="p6_refuse">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ===== PHASE 7: LLM Generation ===== -->
        <mxCell id="phase7" value="7. Sinh câu trả lời (LLM Generation)" style="swimlane;startSize=25;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="1060" y="380" width="520" height="260" as="geometry" />
        </mxCell>

        <mxCell id="p7_prompt" value="prompt_builder.py&#xa;&#xa;Input:&#xa;• Câu hỏi đã chuẩn hóa&#xa;• Chunks được cấp quyền&#xa;• Metadata locator" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;" vertex="1" parent="phase7">
          <mxGeometry x="20" y="35" width="200" height="100" as="geometry" />
        </mxCell>

        <mxCell id="p7_primary" value="Gemini 3.5 Flash&#xa;(Primary provider)&#xa;Structured JSON output" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;" vertex="1" parent="phase7">
          <mxGeometry x="260" y="35" width="220" height="65" as="geometry" />
        </mxCell>

        <mxCell id="p7_fallback" value="Ollama 0.31.2&#xa;(Fallback — 1 lần duy nhất)&#xa;Chỉ khi: timeout / 429 / 5xx" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="phase7">
          <mxGeometry x="260" y="115" width="220" height="60" as="geometry" />
        </mxCell>

        <mxCell id="p7_no_fallback" value="KHÔNG fallback khi:&#xa;• Lỗi validation&#xa;• Lỗi xác thực&#xa;• Safety refusal&#xa;• Evidence Gate từ chối" style="shape=note;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;size=14;align=left;fontSize=10;" vertex="1" parent="phase7">
          <mxGeometry x="20" y="155" width="200" height="85" as="geometry" />
        </mxCell>

        <mxCell id="p7_output" value="Output JSON:&#xa;answer, claims[],&#xa;citationIds[], refusal,&#xa;refusalReason" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="phase7">
          <mxGeometry x="310" y="190" width="180" height="60" as="geometry" />
        </mxCell>

        <mxCell id="ep7_1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;" edge="1" parent="phase7" source="p7_prompt" target="p7_primary">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ep7_fb" value="Lỗi" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;dashed=1;strokeColor=#666666;" edge="1" parent="phase7" source="p7_primary" target="p7_fallback">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ep7_out" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;" edge="1" parent="phase7" source="p7_primary" target="p7_output">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="500" y="68" />
              <mxPoint x="500" y="220" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- ===== PHASE 8: Citation Validation ===== -->
        <mxCell id="phase8" value="8. Citation Validation &amp; Response" style="swimlane;startSize=25;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="680" width="760" height="260" as="geometry" />
        </mxCell>

        <mxCell id="p8_validate" value="citation_validator.py&#xa;&#xa;Kiểm tra từng citation:&#xa;• documentId ∈ allowedDocumentIds?&#xa;• Chunk tồn tại trong ChromaDB?&#xa;• Excerpt khớp contentHash?&#xa;• Locator hợp lệ?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;" vertex="1" parent="phase8">
          <mxGeometry x="20" y="40" width="260" height="110" as="geometry" />
        </mxCell>

        <mxCell id="p8_locator" value="Locator types:&#xa;• PDF → pageNumber&#xa;• DOCX → logicalBlock / paragraph / tableCell&#xa;• TXT → lineStart–lineEnd&#xa;&#xa;Mỗi locator gắn contentHash + extractorVersion" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;size=14;align=left;fontSize=10;" vertex="1" parent="phase8">
          <mxGeometry x="20" y="165" width="260" height="85" as="geometry" />
        </mxCell>

        <mxCell id="p8_check" value="Citation&#xa;hợp lệ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="phase8">
          <mxGeometry x="340" y="55" width="120" height="80" as="geometry" />
        </mxCell>

        <mxCell id="p8_ok" value="✅ Trả ANSWER response&#xa;với citations đầy đủ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="phase8">
          <mxGeometry x="540" y="40" width="200" height="50" as="geometry" />
        </mxCell>

        <mxCell id="p8_retry" value="Retry đúng 1 lần&#xa;(cùng evidence)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;dashed=1;" vertex="1" parent="phase8">
          <mxGeometry x="340" y="160" width="150" height="50" as="geometry" />
        </mxCell>

        <mxCell id="p8_final_refuse" value="❌ REFUSE&#xa;(lần 2 vẫn sai →&#xa;không mở rộng corpus)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="phase8">
          <mxGeometry x="540" y="150" width="200" height="55" as="geometry" />
        </mxCell>

        <mxCell id="ep8_1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;" edge="1" parent="phase8" source="p8_validate" target="p8_check">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ep8_ok" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#82b366;" edge="1" parent="phase8" source="p8_check" target="p8_ok">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ep8_retry" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#d6b656;dashed=1;" edge="1" parent="phase8" source="p8_check" target="p8_retry">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ep8_final" value="Vẫn sai" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#b85450;" edge="1" parent="phase8" source="p8_retry" target="p8_final_refuse">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ===== PHASE 9: Retrieval Trace ===== -->
        <mxCell id="phase9" value="9. Retrieval Trace (Observability)" style="swimlane;startSize=25;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="840" y="680" width="740" height="260" as="geometry" />
        </mxCell>

        <mxCell id="p9_trace" value="trace_builder.py&#xa;&#xa;Lưu bắt buộc mỗi request:&#xa;requestId, userId (pseudonymized),&#xa;workspaceId, intent, ruleId,&#xa;confidence, strategyVersion" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;" vertex="1" parent="phase9">
          <mxGeometry x="20" y="40" width="230" height="100" as="geometry" />
        </mxCell>

        <mxCell id="p9_detail" value="Chi tiết trace:&#xa;• allowedDocumentCount&#xa;• Retrieved chunk IDs + scores&#xa;• coverageScore&#xa;• evidenceScore + decision&#xa;• refusalCode&#xa;• provider, latencyMs&#xa;• promptTokens, configHash&#xa;• UTC timestamp" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;" vertex="1" parent="phase9">
          <mxGeometry x="280" y="35" width="220" height="155" as="geometry" />
        </mxCell>

        <mxCell id="p9_items" value="retrieval_trace_items:&#xa;• documentId, chunkId&#xa;• rank, similarity&#xa;• sourceGroup&#xa;• locatorValue, contentHash&#xa;&#xa;⚠ KHÔNG lưu toàn văn&#xa;chunk hoặc câu hỏi" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;" vertex="1" parent="phase9">
