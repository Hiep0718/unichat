        <!-- Status flow note -->
        <mxCell id="status_flow" value="Document Status Flow:&#xa;PENDING → PROCESSING → PROCESSED ✅&#xa;PENDING → PROCESSING → FAILED ❌" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;size=14;align=left;fontSize=11;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="780" y="690" width="280" height="65" as="geometry" />
        </mxCell>

      </root>
