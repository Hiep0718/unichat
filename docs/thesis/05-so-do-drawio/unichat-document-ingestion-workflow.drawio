        </mxCell>
        <mxCell id="e3" value="Xóa vector&#xa;(ChromaDB)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="phaseE">
