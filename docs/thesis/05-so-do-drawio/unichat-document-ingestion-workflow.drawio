        <mxCell id="ee2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;" edge="1" parent="phaseE" source="e2" target="e3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ee3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;" edge="1" parent="phaseE" source="e3" target="e4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ee4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;" edge="1" parent="phaseE" source="e4" target="e5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ee5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;" edge="1" parent="phaseE" source="e5" target="e6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ee6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;" edge="1" parent="phaseE" source="e6" target="e7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Cross-phase edges -->
        <mxCell id="cross_AB" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#333333;strokeWidth=2;" edge="1" parent="1" source="a_save" target="b_claim">
          <mxGeometry relative="1" as="geometry">
