        <mxCell id="ed_fail" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#b85450;" edge="1" parent="phaseD" source="d_failed" target="d_fail_status">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ===== PHASE E: Delete Saga ===== -->
        <mxCell id="phaseE" value="E. Delete Saga (Xóa tài liệu)" style="swimlane;startSize=25;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="860" width="1300" height="140" as="geometry" />
