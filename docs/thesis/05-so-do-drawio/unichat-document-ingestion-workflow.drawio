        <mxCell id="cross_CD_ok" value="Thành công" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#82b366;strokeWidth=2;" edge="1" parent="1" source="c_done" target="d_success">
