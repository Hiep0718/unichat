              <mxPoint x="800" y="130" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="cross_BC" value="Service JWT" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#333333;strokeWidth=2;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b_call" target="c_detect">
          <mxGeometry relative="1" as="geometry">
