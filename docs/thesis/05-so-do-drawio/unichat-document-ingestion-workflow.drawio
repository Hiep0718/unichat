<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram name="Document Ingestion Workflow" id="document-ingestion">
    <mxGraphModel dx="1700" dy="1200" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1700" pageHeight="1200">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="UniChat — Luồng Xử Lý Tài Liệu (Document Ingestion Workflow)" style="text;html=1;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="300" y="10" width="600" height="40" as="geometry" />
        </mxCell>

        <!-- ===== PHASE A: Upload ===== -->
        <mxCell id="phaseA" value="A. Upload (Client → Core API)" style="swimlane;startSize=25;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="740" height="200" as="geometry" />
        </mxCell>

        <mxCell id="a_user" value="Người dùng chọn file&#xa;(PDF, DOCX, TXT)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="phaseA">
          <mxGeometry x="20" y="40" width="150" height="60" as="geometry" />
        </mxCell>

        <mxCell id="a_upload" value="POST /api/v1/workspaces/&#xa;{wId}/documents&#xa;multipart/form-data&#xa;+ Idempotency-Key" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="phaseA">
          <mxGeometry x="200" y="35" width="200" height="70" as="geometry" />
        </mxCell>

        <mxCell id="a_validate" value="Validation:&#xa;• ≤ 20 MiB/file&#xa;• PDF ≤ 500 trang&#xa;• DOCX ≤ 2000 blocks&#xa;• TXT UTF-8&#xa;• ≤ 100 docs / 1 GiB / ws" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;size=14;align=left;fontSize=10;" vertex="1" parent="phaseA">
          <mxGeometry x="200" y="115" width="200" height="80" as="geometry" />
        </mxCell>

        <mxCell id="a_save" value="Lưu file +&#xa;Tạo document (PENDING)&#xa;+ resource_job (INGEST)&#xa;trong single transaction" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="phaseA">
          <mxGeometry x="430" y="35" width="210" height="70" as="geometry" />
        </mxCell>

        <mxCell id="a_response" value="202 Accepted&#xa;documentId, jobId,&#xa;status: PENDING" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="phaseA">
          <mxGeometry x="430" y="120" width="180" height="60" as="geometry" />
        </mxCell>

        <mxCell id="eaA1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;" edge="1" parent="phaseA" source="a_user" target="a_upload">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="eaA2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;" edge="1" parent="phaseA" source="a_upload" target="a_save">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="eaA3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;" edge="1" parent="phaseA" source="a_save" target="a_response">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ===== PHASE B: Job Processing ===== -->
        <mxCell id="phaseB" value="B. RabbitMQ Consumer (Core API)" style="swimlane;startSize=25;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="820" y="60" width="520" height="200" as="geometry" />
        </mxCell>

        <mxCell id="b_claim" value="RabbitMQ Consumer&#xa;nhận ingestion message&#xa;+ auto-acknowledgment" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="phaseB">
          <mxGeometry x="20" y="40" width="200" height="65" as="geometry" />
        </mxCell>

        <mxCell id="b_status" value="Document status:&#xa;PENDING → PROCESSING" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="phaseB">
          <mxGeometry x="20" y="120" width="200" height="50" as="geometry" />
        </mxCell>

        <mxCell id="b_call" value="Gọi AI Service&#xa;POST /internal/v1/ingestions&#xa;+ Service JWT&#xa;(idempotent)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;" vertex="1" parent="phaseB">
          <mxGeometry x="280" y="40" width="220" height="70" as="geometry" />
        </mxCell>

        <mxCell id="b_retry" value="Retry / backoff&#xa;trạng thái lỗi" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="phaseB">
          <mxGeometry x="300" y="130" width="160" height="45" as="geometry" />
        </mxCell>

        <mxCell id="ebB1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;" edge="1" parent="phaseB" source="b_claim" target="b_status">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ebB2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;" edge="1" parent="phaseB" source="b_claim" target="b_call">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ebB3" value="Lỗi" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;dashed=1;strokeColor=#b85450;" edge="1" parent="phaseB" source="b_call" target="b_retry">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ===== PHASE C: AI Ingestion Pipeline ===== -->
        <mxCell id="phaseC" value="C. AI Service Ingestion Pipeline (FastAPI)" style="swimlane;startSize=25;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="300" width="1300" height="310" as="geometry" />
        </mxCell>

        <!-- Extraction sub-section -->
        <mxCell id="c_extract_box" value="Extraction" style="swimlane;startSize=20;fillColor=#f5f5f5;strokeColor=#666666;rounded=1;" vertex="1" parent="phaseC">
          <mxGeometry x="20" y="40" width="280" height="250" as="geometry" />
        </mxCell>

        <mxCell id="c_detect" value="Phát hiện loại file&#xa;(mediaType)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="c_extract_box">
          <mxGeometry x="60" y="30" width="160" height="45" as="geometry" />
        </mxCell>

        <mxCell id="c_pdf" value="pdf_extractor.py&#xa;(≤ 500 trang)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="c_extract_box">
          <mxGeometry x="10" y="95" width="140" height="45" as="geometry" />
        </mxCell>

        <mxCell id="c_docx" value="docx_extractor.py&#xa;(≤ 2000 blocks)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="c_extract_box">
          <mxGeometry x="10" y="150" width="140" height="45" as="geometry" />
        </mxCell>

        <mxCell id="c_txt" value="text_extractor.py&#xa;(UTF-8)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="c_extract_box">
          <mxGeometry x="10" y="200" width="140" height="40" as="geometry" />
        </mxCell>

        <mxCell id="c_struct" value="Structured&#xa;text output" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="c_extract_box">
          <mxGeometry x="170" y="140" width="100" height="50" as="geometry" />
        </mxCell>

        <mxCell id="ec_det_pdf" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;" edge="1" parent="c_extract_box" source="c_detect" target="c_pdf">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ec_pdf_s" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;" edge="1" parent="c_extract_box" source="c_pdf" target="c_struct">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ec_docx_s" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;" edge="1" parent="c_extract_box" source="c_docx" target="c_struct">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ec_txt_s" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;" edge="1" parent="c_extract_box" source="c_txt" target="c_struct">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Chunking -->
        <mxCell id="c_chunk" value="chunker.py&#xa;&#xa;Chia text thành&#xa;chunks phù hợp&#xa;kích thước ngữ nghĩa" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="phaseC">
          <mxGeometry x="330" y="80" width="180" height="90" as="geometry" />
        </mxCell>

        <!-- Locator -->
        <mxCell id="c_locator" value="locator.py&#xa;&#xa;Gán locator cho mỗi chunk:&#xa;• PDF: pageNumber&#xa;• DOCX: logicalBlock/&#xa;  paragraph/tableCell&#xa;• TXT: lineStart–lineEnd&#xa;&#xa;+ contentHash&#xa;+ extractorVersion" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;" vertex="1" parent="phaseC">
          <mxGeometry x="330" y="185" width="180" height="115" as="geometry" />
        </mxCell>

        <!-- Embedding -->
        <mxCell id="c_embed" value="e5_embedding_adapter.py&#xa;&#xa;multilingual-e5-base&#xa;768 dimensions&#xa;prefix: passage:&#xa;frozen revision" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=0;" vertex="1" parent="phaseC">
          <mxGeometry x="560" y="60" width="210" height="100" as="geometry" />
        </mxCell>

        <mxCell id="c_embed_note" value="Embedding model:&#xa;intfloat/multilingual-e5-base&#xa;revision: d128750597153bb5987e10b&#xa;&#xa;Hỗ trợ tiếng Việt / đa ngôn ngữ&#xa;Chạy local, tái lập được" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;size=14;align=left;fontSize=10;" vertex="1" parent="phaseC">
          <mxGeometry x="560" y="180" width="210" height="100" as="geometry" />
        </mxCell>

        <!-- Vector Store -->
        <mxCell id="c_store" value="chroma_adapter.py&#xa;&#xa;Upsert vào ChromaDB&#xa;unichat_chunks_v1&#xa;(cosine, 768d)" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="phaseC">
          <mxGeometry x="830" y="55" width="210" height="110" as="geometry" />
        </mxCell>

        <mxCell id="c_store_meta" value="Mỗi Chroma record:&#xa;• chunkId, workspaceId&#xa;• documentId, ingestionVersion&#xa;• chunkIndex, sourceGroup&#xa;• locatorType, locatorValue&#xa;• contentHash, extractorVersion&#xa;• normalized text (embedding)" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;size=14;align=left;fontSize=10;" vertex="1" parent="phaseC">
          <mxGeometry x="830" y="180" width="210" height="120" as="geometry" />
        </mxCell>

        <!-- Success -->
        <mxCell id="c_done" value="✅ Ingestion&#xa;thành công" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="phaseC">
          <mxGeometry x="1100" y="80" width="140" height="50" as="geometry" />
        </mxCell>

        <!-- Edges in Phase C -->
        <mxCell id="ec_chunk" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;" edge="1" parent="phaseC" source="c_struct" target="c_chunk">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="310" y="205" />
              <mxPoint x="310" y="125" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="ec_loc" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;" edge="1" parent="phaseC" source="c_chunk" target="c_locator">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ec_emb" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;" edge="1" parent="phaseC" source="c_chunk" target="c_embed">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ec_store" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;" edge="1" parent="phaseC" source="c_embed" target="c_store">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ec_done" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;" edge="1" parent="phaseC" source="c_store" target="c_done">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ===== PHASE D: Status Update ===== -->
        <mxCell id="phaseD" value="D. Cập nhật trạng thái (Core API)" style="swimlane;startSize=25;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="650" width="1300" height="170" as="geometry" />
        </mxCell>

        <mxCell id="d_success" value="Ingestion thành công" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="phaseD">
          <mxGeometry x="30" y="40" width="160" height="50" as="geometry" />
        </mxCell>

        <mxCell id="d_processed" value="document.status =&#xa;PROCESSED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="phaseD">
          <mxGeometry x="240" y="40" width="170" height="50" as="geometry" />
        </mxCell>

        <mxCell id="d_ready" value="✅ Tài liệu sẵn sàng&#xa;cho Adaptive Retrieval&#xa;&#xa;Chunks có thể được truy vấn&#xa;trong chat hỏi đáp" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="phaseD">
          <mxGeometry x="480" y="35" width="220" height="80" as="geometry" />
        </mxCell>

        <mxCell id="d_failed" value="Ingestion thất bại" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="phaseD">
          <mxGeometry x="30" y="110" width="160" height="40" as="geometry" />
        </mxCell>

        <mxCell id="d_fail_status" value="document.status =&#xa;FAILED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="phaseD">
          <mxGeometry x="240" y="105" width="170" height="50" as="geometry" />
        </mxCell>

        <mxCell id="ed_suc" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;" edge="1" parent="phaseD" source="d_success" target="d_processed">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ed_ready" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;" edge="1" parent="phaseD" source="d_processed" target="d_ready">
