# =============================================================================
# UniChat EC2 environment template for docker-compose.yml
#   cp .env.production.example .env && chmod 600 .env
# Never commit the filled-in .env.
# =============================================================================

# --- Public entry point -------------------------------------------------------
# Exact browser origin (scheme + host, no trailing slash). Must match what users
# type, e.g. http://13.212.10.20 or https://unichat.example.edu.vn
FRONTEND_ORIGIN=http://<EC2-PUBLIC-IP>
CORS_ALLOWED_ORIGINS=http://<EC2-PUBLIC-IP>
HTTP_PORT=80

# "local"      -> plain HTTP by IP: non-Secure cookies, CSRF disabled (ADR-020 demo mode)
# "production" -> ONLY behind HTTPS: Secure cookies, CSRF, HTTPS redirect
UNICHAT_SECURITY_PROFILE=local

LOG_LEVEL=INFO

# --- Supabase PostgreSQL (Session Pooler, port 5432) ------------------------
POSTGRES_URL=jdbc:postgresql://aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require&prepareThreshold=0
POSTGRES_USER=postgres.<your-project-id>
POSTGRES_PASSWORD=

# --- CloudAMQP ----------------------------------------------------------------
RABBITMQ_URL=amqps://<user>:<password>@<host>.rmq.cloudamqp.com/<vhost>

# --- Chroma Cloud -------------------------------------------------------------
CHROMA_MODE=cloud
CHROMA_CLOUD_API_KEY=
CHROMA_CLOUD_TENANT=
CHROMA_CLOUD_DATABASE=default_database

# --- Supabase Storage ---------------------------------------------------------
STORAGE_PROVIDER=supabase
SUPABASE_STORAGE_URL=https://<your-project-id>.supabase.co/storage/v1
SUPABASE_SERVICE_KEY=
SUPABASE_STORAGE_BUCKET=documents

# --- Security secrets ---------------------------------------------------------
# Required by Core API (>= 32 chars). Generate: openssl rand -hex 32
OTP_HMAC_SECRET=

# --- LLM providers: Gemini primary, Hive fallback (ADR-024) -------------------
LLM_PROVIDER=gemini
LLM_FALLBACK_PROVIDER=hive
ENABLE_PROVIDER_FALLBACK=true
GEMINI_API_KEY=
GEMINI_API_KEY_2=
GEMINI_MODEL=gemini-3.5-flash
HIVE_API_KEY=
HIVE_API_KEY_2=

# --- Feature flags ------------------------------------------------------------
# Enable only after migration V47 is applied to the target database.
QUERY_PLANNER_ENABLED=false
WORKSPACE_SUMMARY_ENABLED=false
UNICHAT_WORKSPACE_SUMMARY_ENABLED=false

# --- SMTP (password reset / OTP e-mails) --------------------------------------
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# --- Optional: pull prebuilt images instead of building on EC2 ----------------
# IMAGE_REGISTRY=ghcr.io/<owner>/unichat
# IMAGE_TAG=<git-sha>
# AI_SERVICE_MEM_LIMIT=2g
# CORE_API_MEM_LIMIT=1g
