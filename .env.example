APP_ENV=local
FRONTEND_ORIGIN=http://localhost:5173
CORE_API_BASE_URL=http://localhost:8082
AI_SERVICE_BASE_URL=http://ai-service:8000

# Supabase Pooler Configuration (Transaction Mode - Port 6543)
# Note: prepareThreshold=0 is required for PgBouncer/Supavisor transaction mode compatibility
POSTGRES_URL=jdbc:postgresql://aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require&options=-c%20TimeZone=Asia/Ho_Chi_Minh&prepareThreshold=0
POSTGRES_DB=postgres
POSTGRES_USER=postgres.<your-project-id>
POSTGRES_PASSWORD=
POSTGRES_PORT=6543

JWT_PUBLIC_KEY_LOCATION=
CSRF_SECRET=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=
CHROMA_BASE_URL=http://chroma:8000
EMBEDDING_MODEL=intfloat/multilingual-e5-base
EMBEDDING_REVISION=d128750597153bb5987e10b1c3493a34e5a4502a
CLOUD_PROVIDER_ALLOWED=false

FILE_STORAGE_ROOT=./data/files
MAX_UPLOAD_BYTES=26214400
LOG_LEVEL=INFO
