APP_ENV=local
# Đọc bởi ai-service (Python). Core API KHÔNG đọc biến này — nó dùng
# CORS_ALLOWED_ORIGINS bên dưới.
FRONTEND_ORIGIN=http://127.0.0.1:5173

# Core API: danh sách origin trình duyệt được phép, dùng chung cho cả CORS lẫn
# socket STOMP. Để trống thì lấy mặc định dev: localhost:5173, 127.0.0.1:5173,
# localhost:8081, localhost:8082.
#
# Khai báo giá trị thì nó THAY THẾ toàn bộ mặc định chứ không cộng thêm, nên
# phải liệt kê cả localhost. Thêm địa chỉ LAN hoặc tên miền tunnel vào đây khi
# muốn thử gọi từ máy khác. Không nhận ký tự *, server sẽ không khởi động.
CORS_ALLOWED_ORIGINS=

# --- Gọi thoại 1:1 (WebRTC) ---
# STUN là đủ cho phần lớn cuộc gọi. Khoảng 10-20% không xuyên được NAT và bắt
# buộc relay qua TURN; để trống TURN thì những ca đó sẽ thất bại.
UNICHAT_CALLS_STUN_URLS=stun:stun.l.google.com:19302
# Nhiều địa chỉ thì ngăn bằng dấu phẩy, ví dụ turn:host:3478,turns:host:5349
UNICHAT_CALLS_TURN_URLS=
# Secret dùng chung với TURN server để ký credential ngắn hạn (RFC 5389).
# Không bao giờ gửi xuống trình duyệt; chỉ chữ ký được gửi.
UNICHAT_CALLS_TURN_SECRET=
# Bao lâu thì bỏ cuộc với cuộc gọi không ai nghe.
UNICHAT_CALLS_RING_TIMEOUT_SECONDS=45
CORE_API_BASE_URL=http://localhost:8082
AI_SERVICE_BASE_URL=http://localhost:8001
# Expo Mobile Dev Server (Tùy chọn, mặc định 8081 hoặc tự động dùng 8085 nếu 8081 bận)
# EXPO_PORT=8081

# Supabase Pooler Configuration (Transaction Mode - Port 6543)
# Note: prepareThreshold=0 is required for PgBouncer/Supavisor transaction mode compatibility
POSTGRES_URL=jdbc:postgresql://aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require&options=-c%20TimeZone=Asia/Ho_Chi_Minh&prepareThreshold=0
POSTGRES_DB=postgres
POSTGRES_USER=postgres.<your-project-id>
POSTGRES_PASSWORD=

# CloudAMQP RabbitMQ (Little Lemur - Free Tier)
# Format: amqps://username:password@host/vhost
RABBITMQ_URL=amqps://username:password@lemon.rmq.cloudamqp.com/vhost

# Document Storage Provider: 'local' or 'supabase'
STORAGE_PROVIDER=supabase
FILE_STORAGE_ROOT=./data/files

# Supabase Storage (Free Tier - 1GB)
SUPABASE_STORAGE_URL=https://<your-project-id>.supabase.co/storage/v1
SUPABASE_SERVICE_KEY=
SUPABASE_STORAGE_BUCKET=documents

JWT_PUBLIC_KEY_LOCATION=
JWT_PRIVATE_KEY_LOCATION=
UNICHAT_SECURITY_PROFILE=local
CSRF_SECRET=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=
CHROMA_BASE_URL=http://localhost:8000
# Chroma Vector DB Mode: 'auto', 'ephemeral', 'server', or 'cloud'
CHROMA_MODE=cloud
CHROMA_CLOUD_TENANT=nguyenthanhhiep_work_0718
CHROMA_CLOUD_DATABASE=default_database
CHROMA_CLOUD_API_KEY=
EMBEDDING_MODEL=intfloat/multilingual-e5-base
EMBEDDING_REVISION=d128750597153bb5987e10b1c3493a34e5a4502a
CLOUD_PROVIDER_ALLOWED=false

MAX_UPLOAD_BYTES=26214400
LOG_LEVEL=INFO
