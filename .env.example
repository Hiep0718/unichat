APP_ENV=local
FRONTEND_ORIGIN=http://127.0.0.1:5173
CORE_API_BASE_URL=http://localhost:8082
AI_SERVICE_BASE_URL=http://localhost:8001
# Expo Mobile Dev Server (Tùy chọn, mặc định 8081 hoặc tự động dùng 8085 nếu 8081 bận)
# EXPO_PORT=8081

# Supabase Session Pooler for the long-running Spring/Hibernate process (port 5432).
# Avoid startup options for timezone; the application already configures its JVM timezone.
POSTGRES_URL=jdbc:postgresql://aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require&prepareThreshold=0
POSTGRES_DB=postgres
POSTGRES_USER=postgres.<your-project-id>
POSTGRES_PASSWORD=

# CloudAMQP RabbitMQ (Little Lemur - Free Tier)
# Format: amqps://username:password@host/vhost
RABBITMQ_URL=amqps://username:password@lemon.rmq.cloudamqp.com/vhost

# Document Storage Provider: 'local' or 'supabase'
STORAGE_PROVIDER=supabase
FILE_STORAGE_ROOT=./data/files

# Supabase Storage (Free Tier - 1GB)
SUPABASE_STORAGE_URL=https://<your-project-id>.supabase.co/storage/v1
SUPABASE_SERVICE_KEY=
SUPABASE_STORAGE_BUCKET=documents

JWT_PUBLIC_KEY_LOCATION=
JWT_PRIVATE_KEY_LOCATION=
UNICHAT_SECURITY_PROFILE=local
CSRF_SECRET=

# Internal RS256 Service Authentication (Core API <-> AI Service)
CORE_SERVICE_KEY_ID=core-service-v1
AI_SERVICE_KEY_ID=ai-service-v1
CORE_SERVICE_PRIVATE_KEY_PATH=.service-keys/core-service-private.pem
CORE_SERVICE_PUBLIC_KEY_PATH=.service-keys/core-service-public.pem
AI_SERVICE_PRIVATE_KEY_PATH=.service-keys/ai-service-private.pem
AI_SERVICE_PUBLIC_KEY_PATH=.service-keys/ai-service-public.pem

# Generation: copy settings intentionally; do not reuse an exposed key.
LLM_PROVIDER=hive
HIVE_BASE_URL=https://api-cdn.thehive.ai/api/v3
HIVE_MODEL=deepseek-ai/deepseek-v4.1-flash-1017
HIVE_API_KEY=
HIVE_API_KEY_2=
HIVE_API_KEYS=
HIVE_MAX_TOKENS=4096
HIVE_TEMPERATURE=0.2
HIVE_TOP_P=0.9
HIVE_REASONING_EFFORT=low
HIVE_READ_IDLE_TIMEOUT_SECONDS=5
ENABLE_OLLAMA_FALLBACK=false
# Explicit rollback only; unset LLM_PROVIDER preserves the legacy Gemini default.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=
CHROMA_BASE_URL=http://localhost:8000
# Chroma Vector DB Mode: 'auto', 'ephemeral', 'server', or 'cloud'
CHROMA_MODE=cloud
CHROMA_CLOUD_TENANT=nguyenthanhhiep_work_0718
CHROMA_CLOUD_DATABASE=default_database
CHROMA_CLOUD_API_KEY=
EMBEDDING_MODEL=intfloat/multilingual-e5-base
EMBEDDING_REVISION=d128750597153bb5987e10b1c3493a34e5a4502a
CLOUD_PROVIDER_ALLOWED=false

MAX_UPLOAD_BYTES=26214400
LOG_LEVEL=INFO
